<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permissions for face detection and document scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Biometric permissions for authentication (matches iOS Face ID/Touch ID) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    
    <!-- NFC permissions for passport reading -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    
    <!-- Camera feature requirements -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application>
        
        <!-- Authentication Activity - Matches iOS AuthenticationProgressView exactly -->
        <activity
            android:name=".ui.activities.AuthenticationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="portrait"
            android:launchMode="singleTop" />
        
        <!-- Approval Activity - Handles approval notifications with proper SDK theming -->
        <activity
            android:name=".ui.activities.ApprovalActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="portrait"
            android:launchMode="singleTop" />
        
        <!-- Standalone App Activity - Bridge to complete standalone application -->
        <activity
            android:name=".standalone.StandaloneAppActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            
            <!-- NFC intent filters for passport scanning -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            
            <meta-data android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            
        </activity>

    </application>

</manifest>
