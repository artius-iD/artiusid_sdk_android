{\b\fs20 3. Icon Theme Configuration}
\par\par
{\f1\fs18
struct SDKIconTheme \{\par
    let iconStyle: String\par
    let mediumIconSize: CGFloat\par
    \par
    // Core UI Icons\par
    let primaryIconColor: UIColor\par
    let secondaryIconColor: UIColor\par
    let accentIconColor: UIColor\par
    let disabledIconColor: UIColor\par
    \par
    // Navigation & Actions\par
    let navigationIconColor: UIColor\par
    let actionIconColor: UIColor\par
    \par
    // Instruction & Feedback\par
    let instructionIconColor: UIColor\par
    let warningIconColor: UIColor\par
    let errorIconColor: UIColor\par
    let successIconColor: UIColor\par
    \par
    // Document & Verification\par
    let documentIconColor: UIColor\par
    let cameraIconColor: UIColor\par
    let scanIconColor: UIColor\par
    \par
    // Security & Biometrics\par
    let biometricIconColor: UIColor\par
    let securityIconColor: UIColor\par
    let nfcIconColor: UIColor\par
    \par
    // Status Indicators\par
    let statusActiveIconColor: UIColor\par
    let statusInactiveIconColor: UIColor\par
    let statusProcessingIconColor: UIColor\par
    \par
    /// Get color for specific icon category\par
    func colorForCategory(_ category: IconCategory) -> UIColor \{\par
        switch category \{\par
        case .primary: return primaryIconColor\par
        case .secondary: return secondaryIconColor\par
        case .accent: return accentIconColor\par
        case .disabled: return disabledIconColor\par
        case .navigation: return navigationIconColor\par
        case .action: return actionIconColor\par
        case .instruction: return instructionIconColor\par
        case .warning: return warningIconColor\par
        case .error: return errorIconColor\par
        case .success: return successIconColor\par
        case .document: return documentIconColor\par
        case .camera: return cameraIconColor\par
        case .scan: return scanIconColor\par
        case .biometric: return biometricIconColor\par
        case .security: return securityIconColor\par
        case .nfc: return nfcIconColor\par
        case .statusActive: return statusActiveIconColor\par
        case .statusInactive: return statusInactiveIconColor\par
        case .statusProcessing: return statusProcessingIconColor\par
        \}\par
    \}\par
\}\par
}
\par\par

