{\b\fs32 iOS Swift Icon Theming Examples}
\par
{\b\fs28 artius.iD SDK - Dynamic PNG Icon Color Theming}
\par\par

{\b\fs20 Overview}
\par
This document shows how to implement dynamic icon color theming in iOS Swift, similar to the Android SDK system. This allows host applications to customize all PNG icon colors throughout the SDK using a centralized theming system.
\par\par

{\b\fs20 1. UIImageView Extension for Icon Tinting}
\par\par
{\f1\fs18
import UIKit\par\par

extension UIImageView \{\par
    /// Apply theme color to icon with specified category\par
    func applyIconTheme(category: IconCategory, theme: SDKIconTheme) \{\par
        guard let image = self.image else \{ return \}\par
        \par
        // Get color for category\par
        let iconColor = theme.colorForCategory(category)\par
        \par
        // Apply tint color to PNG icon\par
        self.image = image.withRenderingMode(.alwaysTemplate)\par
        self.tintColor = iconColor\par
    \}\par
\}\par\par

// Usage Example\par
let documentIcon = UIImageView(image: UIImage(named: "ic_passport"))\par
documentIcon.applyIconTheme(category: .document, theme: currentTheme.iconTheme)\par
}
\par\par

